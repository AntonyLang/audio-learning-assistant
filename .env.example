# ---- deployment ---------------------------------------------------------
APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+asyncpg://ala:ala@localhost:55432/ala
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-only-change-me
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
# Run queued runs inside the API process. Set to false when a Celery worker is running.
INLINE_WORKER=true

# ---- providers ----------------------------------------------------------
# fake = deterministic local adapters (no keys, real audio files via ffmpeg)
# cloud = the pinned DashScope / Tavily / S3 set below
PROVIDER_MODE=fake
DASHSCOPE_API_KEY=
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
TTS_MODEL=qwen3-tts-flash
TTS_PROVIDER=dashscope
# openai 可连接私有 CPU TTS 的 /v1/audio/speech；此时无需 TTS_API_KEY。
# qwen-native 使用 C 引擎，并显式发送语言和 Qwen 采样参数。
TTS_TIMEOUT_SECONDS=120
TTS_VOICE=Cherry
TTS_LANGUAGE=Chinese
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_API_KEY=
TAVILY_API_KEY=

# ---- storage ------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_DIR=./_data/objects
WORK_DIR=./_data/work
S3_ENDPOINT=
S3_BUCKET=audio-learning
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- demo bootstrap -----------------------------------------------------
SEED_DEMO_USER=true
DEMO_EMAIL=demo@local
DEMO_PASSWORD=demo12345
# 生产环境关闭 SEED_DEMO_USER，使用首次启动账号。
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
