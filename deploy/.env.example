# 复制为部署目录中的 .env，权限 0600；不要提交真实凭据。
BACKEND_IMAGE=ghcr.io/antonylang/audio-learning-assistant-api:RELEASE
WEB_IMAGE=ghcr.io/antonylang/audio-learning-assistant-web:RELEASE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
PUBLIC_HOST=REPLACE_WITH_VPS_IP_OR_HOSTNAME
PUBLIC_BASE_URL=https://REPLACE_WITH_VPS_IP_OR_HOSTNAME
APP_ENV=production
COOKIE_SECURE=true
SEED_DEMO_USER=false
INLINE_WORKER=false
APP_TIMEZONE=Asia/Shanghai
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS

# 模型选型及真实密钥确认后再发布；不将模拟模型作为正式服务。
PROVIDER_MODE=cloud
DASHSCOPE_API_KEY=
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_THINKING=disabled
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_LANGUAGE=Chinese
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 可选；为空时只用投递材料，缺口会明确记录，不访问未配置的搜索服务。
TAVILY_API_KEY=
